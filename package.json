{
  "name": "orca",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "engines": {
    "node": "24.14.x"
  },
  "packageManager": "npm@11.11.0",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "2.110.8",
    "expo": "~57.0.8",
    "expo-constants": "~57.0.7",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.8",
    "expo-splash-screen": "~57.0.5",
    "expo-system-ui": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "4.0.0",
    "react-native-worklets": "0.10.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.0",
    "expo-doctor": "1.20.1",
    "prettier": "^3.9.6",
    "supabase": "2.109.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "expo lint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src app.json package.json tsconfig.json eslint.config.js .github",
    "format:check": "prettier --check src app.json package.json tsconfig.json eslint.config.js .github",
    "doctor": "expo-doctor",
    "expo:check": "expo install --check",
    "db:start": "supabase db start",
    "db:reset": "supabase db reset --local",
    "db:lint": "supabase db lint --local --schema public --schema private --level warning --fail-on warning",
    "db:test": "supabase test db --local supabase/tests",
    "db:types": "supabase gen types --local --schema public > src/types/database.ts",
    "db:types:check": "supabase gen types --local --schema public | diff -u src/types/database.ts -"
  },
  "private": true
}
