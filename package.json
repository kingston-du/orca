{
  "name": "orca",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "engines": {
    "node": "24.14.x"
  },
  "packageManager": "npm@11.11.0",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "7.11.0",
    "@supabase/supabase-js": "2.110.8",
    "@tanstack/react-query": "5.101.4",
    "expo": "~57.0.9",
    "expo-camera": "~57.0.3",
    "expo-constants": "~57.0.8",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.10",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-image-manipulator": "~57.0.7",
    "expo-image-picker": "~57.0.7",
    "expo-linking": "~57.0.4",
    "expo-notifications": "~57.0.8",
    "expo-router": "~57.0.9",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "4.0.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.1",
    "expo-doctor": "1.20.1",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.3",
    "jpeg-js": "0.4.4",
    "prettier": "^3.9.6",
    "supabase": "2.109.1",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "brace-expansion@1": "1.1.17"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "expo lint --max-warnings=0",
    "legal:check": "shasum -a 256 --check legal/development-2026-07-27/SHA256SUMS",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src scripts supabase/functions docs PROJECT.md AGENTS.md README.md app.json app.config.js eas.json package.json tsconfig.json eslint.config.js .github",
    "format:check": "prettier --check src scripts supabase/functions docs PROJECT.md AGENTS.md README.md app.json app.config.js eas.json package.json tsconfig.json eslint.config.js .github",
    "doctor": "expo-doctor",
    "moderate": "node scripts/moderation.mjs",
    "expo:check": "expo install --check",
    "native:check": "node scripts/check-native-config.mjs",
    "db:start": "supabase start",
    "db:reset": "supabase db reset --local",
    "db:lint": "supabase db lint --local --schema public --schema private --level warning --fail-on warning",
    "db:test": "supabase test db --local supabase/tests",
    "db:test:api": "node scripts/test-friend-foundation-api.mjs && node scripts/test-avatar-media-api.mjs && node scripts/test-moment-media-api.mjs && node scripts/test-safety-api.mjs && node scripts/test-notifications-api.mjs",
    "functions:test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test supabase/functions/tests/*.test.mjs",
    "functions:test:api": "node scripts/test-avatar-functions.mjs && node scripts/test-moment-functions.mjs && node scripts/test-moderation-functions.mjs",
    "db:types": "supabase gen types --local --schema public > src/types/database.ts",
    "db:types:check": "supabase gen types --local --schema public | diff -u src/types/database.ts -"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ]
  },
  "private": true
}
