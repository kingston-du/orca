EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Runtime label only; it never contains a project reference or credential.
# Local development uses development, internal TestFlight uses preview, and a
# future production-backed build uses production.
EXPO_PUBLIC_ORCA_ENVIRONMENT=development

# The published safety and support mailbox. Until it is set, the app's Support
# screen says plainly that no address is configured; it never invents one.
EXPO_PUBLIC_SUPPORT_EMAIL=

# Sentry's DSN. Crash reporting is entirely inert without it: no initialization,
# no events, no network. A DSN is public by design, unlike the source-map upload
# token, which belongs in EAS build secrets and never in this file.
EXPO_PUBLIC_SENTRY_DSN=

# Source-map upload configuration is consumed only during native/EAS builds.
# SENTRY_AUTH_TOKEN is sensitive and must be stored in EAS, never in this file.
SENTRY_ORG=
SENTRY_PROJECT=
