{
  "cli": {
    "version": "21.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "node": "24.14.1",
      "env": {
        "APP_VARIANT": "development"
      },
      "ios": {
        "image": "sdk-57"
      },
      "android": {
        "image": "sdk-57"
      }
    },
    "testflight": {
      "distribution": "store",
      "environment": "preview",
      "node": "24.14.1",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_ORCA_ENVIRONMENT": "preview"
      },
      "ios": {
        "image": "sdk-57"
      }
    },
    "production": {
      "distribution": "store",
      "environment": "production",
      "node": "24.14.1",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_ORCA_ENVIRONMENT": "production"
      },
      "ios": {
        "image": "sdk-57"
      }
    }
  },
  "submit": {
    "testflight": {},
    "production": {}
  }
}
